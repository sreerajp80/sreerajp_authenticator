  "@helpTime11": {
    "description": "Help: time sync: bullet point."
  },
  "helpTime12": "Each tap uses up one code. Tap only when you need a code: the service may reject codes if you skip too many.",
  "@helpTime12": {
    "description": "Help: time sync: bullet point."
