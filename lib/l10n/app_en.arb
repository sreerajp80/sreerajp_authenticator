    "description": "Help: FAQ: answer."
  },
  "helpFaq08": "How are HOTP codes different from TOTP codes?",
  "@helpFaq08": {
    "description": "Help: FAQ: question."
  },
  "helpFaq09": "TOTP codes change every 30 seconds based on time. HOTP codes change only when you tap the next code button, and each tap uses up one code.",
  "@helpFaq09": {
    "description": "Help: FAQ: answer."
  },
  "helpFaq10": "Security & privacy",
  "@helpFaq10": {
    "description": "Help: FAQ: heading."
  },
  "helpFaq11": "Why is the app blank when I switch apps?",
  "@helpFaq11": {
    "description": "Help: FAQ: question."
  },
  "helpFaq12": "The screenshot guard, on by default, turns on Android FLAG_SECURE. It stops screen recorders and the recent-apps view from capturing your codes.",
  "@helpFaq12": {
    "description": "Help: FAQ: answer."
  },
  "helpFaq13": "Does {appName} send any data online?",
  "@helpFaq13": {
    "description": "Help: FAQ: question. {appName} = the app name.",
    "placeholders": {
      "appName": {
        "type": "String"
      }
    }
  },
  "helpFaq14": "No. {appName} works offline. It has no analytics, tracking or cloud service. Your data leaves the device only when you start a Wi-Fi sync on your local network, an optical transfer, or a backup export.",
  "@helpFaq14": {
    "description": "Help: FAQ: answer. {appName} = the app name.",
    "placeholders": {
      "appName": {
        "type": "String"
      }
    }
  },
  "helpFaq15": "What if my fingerprint or face is not recognized?",
  "@helpFaq15": {
    "description": "Help: FAQ: question."
  },
  "helpFaq16": "You can unlock with your phone screen lock PIN, pattern or password, or with your App PIN.",
  "@helpFaq16": {
    "description": "Help: FAQ: answer."
  },
  "helpFaq17": "Backups & moving phones",
  "@helpFaq17": {
    "description": "Help: FAQ: heading."
  },
  "helpFaq18": "How do I move my accounts to a new phone?",
  "@helpFaq18": {
    "description": "Help: FAQ: question."
  },
  "helpFaq19": "Use “{syncDevices}” over local Wi-Fi, scan an optical QR stream, or export an encrypted backup on the old phone and restore it on the new one.",
  "@helpFaq19": {
    "description": "Help: FAQ: answer. {syncDevices} = the current name of that menu item or button.",
    "placeholders": {
      "syncDevices": {
        "type": "String"
      }
    }
  },
  "helpFaq20": "What if I forget my backup password?",
  "@helpFaq20": {
    "description": "Help: FAQ: question."
  },
  "helpFaq21": "Backups use AES-256 encryption and there is no server, so a lost backup password cannot be recovered. Keep it written down safely.",
  "@helpFaq21": {
    "description": "Help: FAQ: answer."
  },
  "helpFaq22": "Will restoring a backup erase my accounts?",
  "@helpFaq22": {
    "description": "Help: FAQ: question."
  },
  "helpFaq23": "No. {appName} only adds accounts. Your existing accounts stay, and duplicates are skipped.",
  "@helpFaq23": {
    "description": "Help: FAQ: answer. {appName} = the app name.",
    "placeholders": {
      "appName": {
        "type": "String"
      }
    }
  },
