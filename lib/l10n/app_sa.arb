  "helpTime12": "प्रत्येकं स्पर्शः एकं सङ्केतं व्ययति। आवश्यके एव स्पृश्यताम्: बहुषु त्यक्तेषु सेवा सङ्केतान् निराकुर्यात्।",
  "helpTime13": "पुनःस्थापितायां प्रतिलिप्यां द्वितीयोपकरणस्थे प्रतिरूपे वा पुरातनः गणकः स्यात्। सेवा सङ्केतं निराकरोति चेत्, समीकरणाय कतिचित् वारान् पुनः स्पृश्यताम्।",
  "helpTime14": "सूचना: अधिकांशाः निराकृतसङ्केताः दूरभाषघटिकायाः दोषात् भवन्ति। स्वचालितः जालकालः एतत् स्थिरतया समादधाति।",
  "helpTags01": "चिह्नानि व्यवस्था च",
  "helpTags02": "चिह्नानि भवतः 2FA-विवरणानि स्वकीयवर्गेषु (यथा कार्यम्, व्यक्तिगतम्, वित्तकोशः, समाजः) स्थापयन्ति, येन सुखेन परिशोधनं भवति।",
  "helpTags03": "विवरणेभ्यः चिह्नदानम्",
  "helpTags04": "विवरणयोजने सम्पादने वा अल्पविरामैः पृथक्कृतानि चिह्ननामानि लिख्यन्ताम् (यथा “कार्यम्, मेघः, तन्त्रम्”)।",
  "helpTags05": "लेखनसमये अनुप्रयोगः विद्यमानचिह्नानि सूचयति, येन नामानि समानानि तिष्ठन्ति।",
  "helpTags06": "प्रयुक्तेभ्यः सर्वचिह्नेभ्यः चेतुं “{browseTags}” स्पृश्यताम्।",
  "helpTags07": "चिह्नानुसारं परिशोधनम्",
  "helpTags08": "मुख्यपटलस्य चिह्नपट्टिका भवतः चिह्नानि स्पर्शनीयपट्टिकारूपेण दर्शयति।",
  "helpTags09": "चिह्नपट्टिकां स्पृष्ट्वा तस्य विवरणानि एव दृश्यन्ते। परिशोधनम् अपनेतुं “{allTags}” स्पृश्यताम्।",
  "helpTags10": "सर्वचिह्नानि प्रत्येकस्य विवरणसङ्ख्या च द्रष्टुं चिह्नमेघं प्रति गम्यताम्।",
  "helpTags11": "चिह्नप्रबन्धनम्",
  "helpTags12": "सर्वविवरणेषु एकदा चिह्ननामपरिवर्तनाय लोपाय वा {settings} → {manageTags} प्रति गम्यताम्। विद्यमानं नाम दत्तं चेत् उभे एकीभवतः।",
  "helpTags13": "चिह्ननामपरिवर्तनेन तद्युक्तानि सर्वविवरणानि नवीक्रियन्ते।",
  "helpTags14": "चिह्नलोपेन विवरणेभ्यः केवलं चिह्नम् अपनीयते; विवरणानि तिष्ठन्ति।",
  "helpTags15": "सूचना: लघूनि चिह्ननामानि (यथा “कार्यम्”, “वित्तम्”) परिशोधनपट्टिकायां सुन्दराणि दृश्यन्ते।",
  "helpLock01": "जैवमितिः अनुप्रयोगतालकं च",
  "helpLock02": "{appName} अङ्गुलिमुद्रया, मुखेन, दूरभाषपटलतालकेन, अनुप्रयोग-PIN-द्वारा वा भवतः सङ्केतान् रक्षितुं शक्नोति।",
  "helpLock03": "अनुप्रयोगतालकं कथं कार्यं करोति",
  "helpLock04": "{settings} → {security} इत्यत्र सक्रियं चेत्, अनुप्रयोगस्य उद्घाटने पुनरागमने च उद्घाटनं याच्यते।",
  "helpLock05": "अनुप्रयोगः उद्घाटितः अतालितः च यावत् तावत् एव विगूढसङ्केताः स्मृतौ तिष्ठन्ति।",
  "helpLock06": "स्वतालनम्",
  "helpLock07": "अनुप्रयोगत्यागे, अन्यानुप्रयोगगमने, दूरभाषपटलतालने वा अनुप्रयोगः तत्क्षणं ताल्यते। उद्घाटितावस्थायां स्वतालनकालानन्तरम् अपि ताल्यते।",
  "helpLock08": "विगूढसङ्केताः स्मृतेः अपनीयन्ते, अतः दूरभाषं गृह्णन् तान् पठितुं न शक्नोति।",
  "helpLock09": "विकल्पः दूरभाषतालकं च",
  "helpLock10": "अङ्गुलिमुद्रा मुखं वा न अभिज्ञायते चेत् (यथा आर्द्राङ्गुलयः, अल्पप्रकाशः), दूरभाषपटलतालकस्य PIN, रेखाचित्रं, गुप्तशब्दः वा प्रयोक्तुं शक्यते।",
  "helpLock11": "परीक्षणम् Android स्वयं करोति। {appName} भवतः जैवमितिदत्तांशं दूरभाषगुप्तसङ्केतं वा कदापि न पश्यति न रक्षति च।",
  "helpLock12": "सूचना: उत्तमरक्षणाय दूरभाषविन्यासे सुरक्षितं पटलतालकं सज्जीक्रियताम्।",
  "helpVault01": "कोशसुरक्षा गोपनीयता च",
  "helpVault02": "{appName} अन्तर्जालं विना कार्याय कस्मिन्नपि सेवके अविश्वासाय च निर्मितम्। भवतः गुप्तकुञ्चिकाः उपकरणे एव गूढलेख्यन्ते, कस्मैचित् अपि दूरसेवकाय न प्रेष्यन्ते।",
  "helpVault03": "AES-256-GCM गूढलेखनम्",
  "helpVault04": "सर्वाणि रहस्यानि सङ्केतविन्यासाः च GCM-विधौ AES-256-द्वारा गूढलेख्यन्ते, यत् दत्तांशस्य कमपि परिवर्तनं ज्ञापयति।",
  "helpVault05": "गूढलेखनकुञ्चिका भवतः उपकरणे रच्यते, Android Keystore-मध्ये रक्ष्यते च (समर्थेषु दूरभाषेषु यन्त्रांशरक्षया)।",
  "helpVault06": "किमपि रहस्यम् अनावृतरूपेण दत्तांशकोशे कदापि न लिख्यते।",
  "helpVault07": "पटलचित्ररक्षा (FLAG_SECURE)",
  "helpVault08": "मूलतः अनुप्रयोगः स्वगवाक्षाय Android FLAG_SECURE सक्रियीकरोति। सुरक्षाविन्यासे एतत् निष्क्रियीकर्तुं शक्यते।",
  "helpVault09": "एतत् पटलचित्राणि, पटलालेखनं, पटलपाठकानुप्रयोगान् च भवतः सङ्केतग्रहणात् निरुणद्धि।",
  "helpVault10": "सद्यःप्रयुक्तानुप्रयोगदर्शने अनुप्रयोगः रिक्तपटलं दर्शयति, अतः समीपस्थाः सङ्केतान् द्रष्टुं न शक्नुवन्ति।",
  "helpVault11": "मेघः न, दूरमापनं न",
  "helpVault12": "अनुप्रयोगे सेवकः, प्रवेशः, विज्ञापनं, विश्लेषणसङ्केतः वा नास्ति।",
  "helpVault13": "भवतः रहस्यानि सङ्केताः च कस्मैचित् अपि सेवकाय न प्रेष्यन्ते। अनुप्रयोगः लेखान्, उपकरणपरिचयान्, उपयोगविवरणं वा न प्रेषयति।",
  "helpVault14": "QR-अवलोकनं, सङ्केतरचना, प्रतिलिपिनिर्यापणं च सर्वम् अन्तर्जालं विना चलति। केवलं Wi-Fi-समन्वयः स्थानीयजालं प्रयुङ्क्ते।",
  "helpVault15": "गोपनीयता प्रथमा: भवतः प्रमाणीकरणरहस्यानि भवतः एव।",
  "helpWifi01": "Wi-Fi-समन्वयः",
  "helpWifi02": "Wi-Fi-समन्वयः एकस्मिन् Wi-Fi-जाले स्थितयोः द्वयोः दूरभाषयोः मध्ये 2FA-विवरणानि साक्षात् स्थानान्तरयति। दत्तांशः गूढलेखितः, कापि मेघसेवा न प्रयुज्यते।",
  "helpWifi03": "Wi-Fi-समन्वयः कथम्",
  "helpWifi04": "पदम् 1: उभे उपकरणे एकस्मिन् Wi-Fi-जाले संयुज्येताम्।",
  "helpWifi05": "पदम् 2: प्रेषक-उपकरणे {settings} → {syncDevices} → “{sendOverWifi}” उद्घाट्यताम्। तत् युग्मन-QR-सङ्केतं युग्मनसङ्केतं च दर्शयति।",
  "helpWifi06": "पदम् 3: स्वीकर्तृ-उपकरणे “{receiveOverWifi}” स्पृष्ट्वा युग्मन-QR-सङ्केतः अवलोक्यताम् (अथवा विवरणानि लिख्यन्ताम्)।",
  "helpWifi07": "पदम् 4: उपकरणे संयुज्येते, प्रेषकः किं वितरणीयम् इति चिनोति।",
  "helpWifi08": "गूढलेखनम्",
  "helpWifi09": "पटले दर्शितात् युग्मनसङ्केतात् (PBKDF2-द्वारा) निर्मितया कुञ्चिकया AES-256-GCM-मध्ये दत्तांशः गूढलेख्यते।",
  "helpWifi10": "युग्मनसङ्केतं विना भवतः Wi-Fi-प्रवाहं निरीक्षमाणः 2FA-रहस्यानि पठितुं न शक्नोति।",
  "helpWifi11": "युग्मनसङ्केतः जालेन कदापि न प्रेष्यते; अवलोकनेन लेखनेन वा भवान् एव तं स्थानान्तरयति।",
  "helpWifi12": "सुरक्षितं संयोजनम्",
  "helpWifi13": "समन्वयः केवलं विवरणानि योजयति। स्वीकर्तृ-उपकरणे किमपि न लुप्यते न परिवर्त्यते च।",
  "helpWifi14": "स्वीकर्तृ-उपकरणे पूर्वमेव विद्यमानानि विवरणानि त्यज्यन्ते।",
  "helpWifi15": "सूचना: प्रेषणसमाप्तिपर्यन्तम् उभे उपकरणे जागृते एकस्मिन् Wi-Fi-जाले च स्थाप्येताम्।",
  "helpOptical01": "प्रकाशीयवायुविच्छेदः",
  "helpOptical02": "प्रकाशीयप्रेषणं Wi-Fi, नीलदन्तं, तन्तून् वा विना चलत्-QR-सङ्केतश्रेण्या अन्तर्जालरहितम् उपकरणं प्रति विवरणानि स्थानान्तरयति।",
  "helpOptical03": "वायुविच्छेदः कः?",
  "helpOptical04": "वायुविच्छिन्नस्य उपकरणस्य कोऽपि जालसम्बन्धः नास्ति (Wi-Fi, नीलदन्तः, चलदूरभाषदत्तांशः न; विमानविधिः सक्रियः)।",
  "helpOptical05": "दत्तांशः पटलात् छायाग्राहकं प्रति केवलं प्रकाशरूपेण गच्छति, अतः श्रवणाय जालं नास्ति। QR-सङ्केताः गूढलेखिताः, तेषां कुञ्चिका च प्रेषकपटले कदापि अदर्शितात् सङ्केतात् निर्मीयते।",
  "helpOptical06": "प्रकाशीयप्रेषणं कथम्",
  "helpOptical07": "पदम् 1: स्वीकर्तृ-उपकरणे {settings} → {syncDevices} → “{scanOptical}” प्रति गम्यताम्। तत् एकवारिकं प्रेषणसङ्केतं दर्शयति।",
  "helpOptical08": "पदम् 2: प्रेषक-उपकरणे “{sendOptical}” चित्वा सः सङ्केतः लिख्यताम्। विवरणानि तेन गूढलेखितानि आवर्तमानया QR-सङ्केतश्रेण्या दर्श्यन्ते।",
  "helpOptical09": "पदम् 3: स्वीकर्तृ-उपकरणे “{startScanning}” स्पृष्ट्वा छायाग्राहकं प्रेषकपटले स्थाप्यताम्।",
  "helpOptical10": "पदम् 4: स्वीकर्ता सर्वान् खण्डान् सङ्गृह्णाति। सर्वेषु खण्डेषु पठितेषु सङ्केते च शुद्धे विवरणानि आनीयन्ते। सङ्केते अशुद्धे किमपि न आनीयते।",
  "helpOptical11": "वेगसूचनाः",
  "helpOptical12": "प्रेषके वेगः प्रतिक्षणं 10, 12, 15 वा चित्रखण्डाः इति निश्चेतुं शक्यते; छायाग्राहकः खण्डान् त्यजति चेत् मन्दवेगः प्रयुज्यताम्।",
  "helpOptical13": "उभे उपकरणे सुप्रकाशे स्थिरं ध्रियेताम्; पटले प्रतिबिम्बं दीप्तिं च परिहरतु।",
  "helpOptical14": "सूचना: सुरक्षिते स्थाने रक्षिताय अन्तर्जालरहिताय प्रतिलिपिदूरभाषाय प्रकाशीयसमन्वयः उचितः।",
  "helpBackup01": "गूढलेखितप्रतिलिपिः",
  "helpBackup02": "दूरभाषस्य क्षतौ नाशे वा नूतनदूरभाषं प्रति गमने वा प्रतिलिपयः भवन्तं रक्षन्ति। प्रत्येका प्रतिलिपिसञ्चिका भवता चितेन गुप्तशब्देन गूढलेख्यते।",
  "helpBackup03": "गूढलेखितप्रतिलिपिरचना",
  "helpBackup04": "{settings} → {backupRestore} → “{createBackup}” स्पृश्यताम्।",
  "helpBackup05": "दृढः प्रतिलिपिगुप्तशब्दः चीयताम्। सञ्चिकायाः गूढलेखनाय अनुप्रयोगः तस्मात् PBKDF2 (300,000 आवृत्तयः) इत्यनेन AES-256-कुञ्चिकां रचयति।",
  "helpBackup06": "गूढलेखिता .aes प्रतिलिपिसञ्चिका उपकरणे, USB-धारके, स्वकीये अन्तर्जालरहिते सञ्चये वा रक्ष्यताम्।",
  "helpBackup07": "गुप्तशब्दसुरक्षा पुनःप्राप्तिः च",
  "helpBackup08": "भवतः प्रतिलिपिगुप्तशब्दः कुत्रापि न रक्ष्यते न प्रेष्यते च। सः स्मर्तव्यः सुरक्षितं लिखित्वा रक्षणीयः वा।",
  "helpBackup09": "{appName} पूर्णतया अन्तर्जालं विना चलति, अतः “गुप्तशब्दविस्मरणम्” सेवकपुनःसज्जीकरणं वा नास्ति। नष्टः प्रतिलिपिगुप्तशब्दः पुनः प्राप्तुं न शक्यते।",
  "helpBackup10": "प्रतिलिपिपुनःस्थापनम्",
  "helpBackup11": "{settings} → {backupRestore} → “{restoreBackup}” स्पृश्यताम्।",
  "helpBackup12": "प्रतिलिपिसञ्चिकां चित्वा तस्याः रचनाकाले प्रयुक्तः गुप्तशब्दः दीयताम्।",
  "helpBackup13": "अनुप्रयोगः सञ्चिकां परीक्ष्य नूतनविवरणानि विद्यमानेषु योजयति; विद्यमानं किमपि न लुप्यते।",
  "helpBackup14": "सूचना: महत्त्वपूर्णानि नूतनानि 2FA-विवरणानि योज्यन्ते यदा यदा तदा तदा नूतना प्रतिलिपिः रच्यताम्।",
  "helpFaq01": "प्रश्नाः समाधानं च",
  "helpFaq02": "2FA-सङ्केताः, पुनःप्राप्तिः, सुरक्षा, सामान्यसमस्याः च इति विषये शीघ्रोत्तराणि।",
  "helpFaq03": "2FA-सङ्केताः",
